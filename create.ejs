<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <title>Tambah Notulensi | E-Notulensi Bawaslu</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<div class="dashboard-wrapper">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="logo-box">
      <img src="/logo_bawaslu.png" alt="Logo Bawaslu">
      <h2>BAWASLU</h2>
    </div>
    <nav>
      <a href="/dashboard" class="<%= currentPath === '/dashboard' ? 'active' : '' %>">Dashboard</a>      
      <a href="/notulensi" class="<%= currentPath.startsWith('/notulensi') ? 'active' : '' %>">Daftar Notulensi</a>
      <!-- KHUSUS PIMPINAN -->
      <% if (user.role_id === 1) { %>
        <a href="/user/tambah"class="<%= currentPath === '/user/tambah' ? 'active' : '' %>"> Tambah User</a>
      <% } %>
        <a href="/pengaturan" class="<%= currentPath === '/pengaturan' ? 'active' : '' %>"> Pengaturan </a>
      <a href="/logout" class="logout">Logout</a>
    </nav>
  </aside>

  <!-- MAIN -->
  <main class="main-content">

    <header class="topbar">
      <h1>Tambah Notulensi</h1>
    </header>

    <div class="settings-card">
        
        <form action="/notulensi/create" method="POST" enctype="multipart/form-data">
          <div class="form-group">
            <label>Tanggal Kegiatan</label>
            <div class="input-box">
              <input type="date" name="tanggal_kegiatan" required><br>
            </div>
          </div>
          <div class="form-group">
            <label>Waktu Mulai</label>
            <div class="input-box">
              <input type="time" name="waktu_mulai" required><br>
            </div>
          </div>
           <div class="form-group">
            <label>Waktu Selesai</label>
            <div class="input-box">
              <input type="time" name="waktu_selesai" required><br>
            </div>
          </div>

           <div class="form-group">
            <label>Tempat</label>
            <div class="input-box">
              <input type="text" name="tempat" required><br>
            </div>
          </div>
          <div class="form-group">
            <label>Agenda</label>
            <div class="input-box">
              <input type="text" name="agenda" required><br>
            </div>
          </div>
          <div class="form-group">
            <label>Pimpinan Kegiatan</label>
            <div class="input-box">
              <input type="text" name="pimpinan"required><br>
            </div>
          </div>
          <div class="form-group">
            <label>Notulis</label>
            <div class="input-box">
              <input type="text" name="notulis" value="<%=user.name %>">
            </div>
            <div class="form-group">
              <label>Peserta Kegiatan</label>
              <textarea 
              name="peserta"class="auto-expand"placeholder="Masukkan peserta kegiatan..." required>
              </textarea>
            </div>

            <div class="form-group">
              <label for="isi_notulensi">Isi Notulensi</label>
              <textarea 
                id="isi_notulensi"name="isi"class="auto-expand"placeholder="Masukkan isi notulensi..."oninput="this.style.height='auto'; this.style.height=(this.scrollHeight) + 'px'"required>
              </textarea>
            </div>
          <div class="form-group">
            <label>Lampiran Dokumentasi</label>
            <div class="input-box">
              <input type="file" name="lampiran">
            </div>
          </div>
          <button type="submit"class="btn-primary full-btn">Simpan</button>
        </form>
    </div>

  </main>
</div>

</body>
</html>
